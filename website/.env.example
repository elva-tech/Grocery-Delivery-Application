# Copy to .env.local for private overrides, or set in CI/hosting.

VITE_API_BASE_URL=http://localhost:5000
VITE_API_URL=http://localhost:5000

# Required on localhost: must match the store you browse and log into (same as admin OTP tenant).
VITE_TENANT_ID=demo-tenant

# If VITE_TENANT_ID is unset, this is used on localhost only (optional).
# VITE_LOCAL_DEFAULT_TENANT_ID=demo-tenant

# VITE_RAZORPAY_KEY_ID=rzp_test_xxx

# Map Service: dev uses Vite /map-service-remote → Render, then /map-service → localhost:3000.
# Production: point at your backend proxy for /api/map/* or enable CORS on the map host.
# VITE_MAP_SERVICE_BASE_URL=
