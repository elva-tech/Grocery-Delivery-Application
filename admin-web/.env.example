# Copy to .env.development.local or .env.production.local and adjust.
#
# VITE_API_URL   — Backend origin (no trailing slash). Local: http://localhost:5000
# Tenant resolution (admin-web):
#   Production URL → hostname (admin.enandi.example.com → enandi)
#   localhost → VITE_TENANT_ID below, else VITE_LOCAL_DEFAULT_TENANT_ID, else demo-tenant
# Do NOT set VITE_TENANT_ID on Vercel/production — hostname is used automatically.

VITE_API_URL=http://localhost:5000
VITE_TENANT_ID=demo-tenant

# Optional localhost fallback when VITE_TENANT_ID is unset:
# VITE_LOCAL_DEFAULT_TENANT_ID=demo-tenant

# Optional (admin UI only)
# VITE_RAZORPAY_KEY_ID=rzp_test_xxx
