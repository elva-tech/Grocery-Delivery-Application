# Optional. No trailing slash.
#
# LOCAL DEV (recommended): comment out or delete VITE_API_URL so the browser calls `/api/...`
# on the Vite dev port; vite.config.js proxies `/api` → http://localhost:5000 (Express backend).
#
# ALTERNATIVE: set explicitly to the Grocery backend:
# VITE_API_URL=http://localhost:5000
#
# Do NOT set this to unrelated apps (e.g. http://localhost:3000) — you will get 404s because
# this super-admin expects routes like POST /api/tenant/create and GET /api/super/tenants.
VITE_API_URL=https://grocery-delivery-application-6n3w.onrender.com