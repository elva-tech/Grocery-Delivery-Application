# Copy to `.env` for private overrides, or edit committed `.env.development` on the team branch.
# Load order: `.env.development` then `.env` (see backend/src/server.js).

PORT=5000

# Required — local Mongo or Atlas URI
MONGO_URI=mongodb://127.0.0.1:27017/grocery_dev

# Required — use a long random string (dev teams often share one on private repos)
JWT_SECRET=replace-with-long-random-string-min-32-chars

# Super Admin login: POST /api/super/login
SUPER_ADMIN_EMAIL=super@example.com
SUPER_ADMIN_PASSWORD=ChangeMe_StrongPassword

# Default tenant when header/query tenant is missing (local/dev tools)
LOCAL_DEFAULT_TENANT_ID=puma

# Razorpay — Key ID can be test mode; Key Secret must match your Razorpay dashboard (never expose live secrets publicly)
RAZORPAY_KEY_ID=rzp_test_xxxxx
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Cloudinary — required for image uploads (products, banners, etc.)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ASSETS_ROOT=grocery_app

# Optional — default "10"
PLATFORM_COMMISSION_PERCENT=10

# Optional — default strict isolation on; set to false only for local experiments without Cloudinary URLs
# STRICT_TENANT_ISOLATION=false
