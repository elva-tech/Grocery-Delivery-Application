# Server
PORT=5000
MONGO_URI=mongodb://localhost:27017/grocery-delivery
JWT_SECRET=your-jwt-secret

# Super admin
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=change-me

# Local development tenant fallback
LOCAL_DEFAULT_TENANT_ID=demo-tenant

# Razorpay (platform billing, and vendor upsert script)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Cashfree credentials are one-time inputs for scripts/upsert-vendor-cashfree.js.
# Runtime reads the encrypted Vendor record. Do not leave real values in this file
# or in backend/.env after the vendor record is saved.
# Never put these in the website or mobile app.
# There is no global CASHFREE_ENVIRONMENT. The vendor cashfree.environment field
# selects SANDBOX or PRODUCTION for that tenant only.
CASHFREE_SANDBOX_APP_ID=
CASHFREE_SANDBOX_SECRET_KEY=
CASHFREE_SANDBOX_WEBHOOK_SECRET=
CASHFREE_PRODUCTION_APP_ID=
CASHFREE_PRODUCTION_SECRET_KEY=
CASHFREE_PRODUCTION_WEBHOOK_SECRET=

# Public HTTPS origin of this API, with no path.
# Cashfree notify_url is ${PUBLIC_API_URL}/api/webhooks/cashfree
# Local webhook tests need a tunnel such as ngrok. Do not use localhost.
PUBLIC_API_URL=

# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Map service (server-side proxy for /api/map/* — fixes browser CORS in production)
MAP_SERVICE_URL=https://ola-map-service.onrender.com
# Ola Maps tile SDK key (served to storefront via GET /api/map/config)
# Alias from ola-map-service: MAP_API_KEY
OLA_MAPS_API_KEY=

# ---------------------------------------------------------------------------
# Notify API (api.notify.elvatech.in)
# All outbound OTP and order SMS flows go through the Notify service layer.
# ---------------------------------------------------------------------------

# Master switch — must be true for any Notify integration to run
NOTIFY_ENABLED=false

# Notify API connection (no secrets committed; set in deployment env)
NOTIFY_BASE_URL=https://api.notify.elvatech.in
NOTIFY_APP_ID=
NOTIFY_API_KEY=
# OTP login template id on Notify (e.g. 7488)
NOTIFY_LOGIN_ID=7488
# JSON map: tenantId → Notify brandId (default includes sales → elva-sales)
# NOTIFY_BRAND_ID_MAP={"sales":"elva-sales","enandi":"enandi"}
# Store name (Tenant.name) is resolved per request for order SMS:

# Per-feature toggles (effective only when NOTIFY_ENABLED=true)
NOTIFY_LOGIN_OTP_ENABLED=true
NOTIFY_ORDER_PLACED_ENABLED=true
NOTIFY_OUT_FOR_DELIVERY_ENABLED=true
NOTIFY_ORDER_DELIVERED_ENABLED=true

MAP_SERVICE_URL=https://ola-map-service.onrender.com
OLA_MAPS_API_KEY=