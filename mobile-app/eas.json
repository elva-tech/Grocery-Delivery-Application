{
  "build": {
    "generic-preview": {
      "android": {
        "buildType": "apk",
        "env": {
          "NPM_CONFIG_LEGACY_PEER_DEPS": "true",
          "EXPO_PUBLIC_ENV": "production",
          "EXPO_PUBLIC_API_URL": "https://grocery-delivery-application-x1yk.onrender.com"
        }
      }
    },
    "generic-production": {
      "android": {
        "buildType": "app-bundle"
      },
      "env": {
        "EXPO_PUBLIC_ENV": "production",
        "EXPO_PUBLIC_API_URL": "https://grocery-delivery-application-x1yk.onrender.com"
      }
    },
    "sales-preview": {
      "extends": "generic-preview",
      "env": {
        "CUSTOMER": "sales",
        "EXPO_PUBLIC_TENANT_ID": "sales",
        "EXPO_PUBLIC_NOTIFY_BRAND_ID": "elva-sales"
      }
    },
    "sales-production": {
      "extends": "generic-production",
      "env": {
        "CUSTOMER": "sales",
        "EXPO_PUBLIC_TENANT_ID": "sales",
        "EXPO_PUBLIC_NOTIFY_BRAND_ID": "elva-sales"
      }
    },
    "enandi-preview": {
      "extends": "generic-preview",
      "env": {
        "CUSTOMER": "enandi",
        "EXPO_PUBLIC_TENANT_ID": "enandi",
        "EXPO_PUBLIC_NOTIFY_BRAND_ID": "enandi"
      }
    },
    "enandi-production": {
      "extends": "generic-production",
      "env": {
        "CUSTOMER": "enandi",
        "EXPO_PUBLIC_TENANT_ID": "enandi",
        "EXPO_PUBLIC_NOTIFY_BRAND_ID": "enandi"
      }
    }
  }
}
