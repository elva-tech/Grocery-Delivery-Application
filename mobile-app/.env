# Committed team defaults for Expo (EXPO_PUBLIC_* are inlined at bundle time).
# Override locally with `.env.local` (gitignored).

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_TENANT_ID=puma

# Uncomment if Metro IP inference fails (device/emulator cannot reach your PC):
# EXPO_PUBLIC_API_DEV_URL=http://YOUR_LAN_IP:5000
