# Local Expo dev — generic multi-tenant app (store code on first open).
# EXPO_PUBLIC_ENV=development

# Optional: skip store-code during dev (generic app only)
# EXPO_PUBLIC_LOCAL_DEFAULT_TENANT_ID=sales

# Optional: test a customer build locally (copy this file to .env first)
# CUSTOMER=enandi

# EXPO_PUBLIC_API_DEV_URL=http://192.168.1.10:5000

# Production API (only used when EXPO_PUBLIC_ENV=production in a release build)
# EXPO_PUBLIC_API_URL=https://grocery-delivery-application-x1yk.onrender.com

# Customer EAS builds (enandi-preview / sales-preview / apnakart-preview) set these in eas.json — optional for local customer dev:
# EXPO_PUBLIC_TENANT_ID=enandi
# EXPO_PUBLIC_NOTIFY_BRAND_ID=enandi
