# Local Expo dev only — not used in EAS production APK builds.
# Tenant is chosen at runtime via store code or QR scan.

# Optional default store while developing (skips store-code screen)
# EXPO_PUBLIC_LOCAL_DEFAULT_TENANT_ID=sales

# Backend URL for dev (otherwise inferred from Metro host :5000)
# EXPO_PUBLIC_API_DEV_URL=http://192.168.1.10:5000

EXPO_PUBLIC_ENV=development
