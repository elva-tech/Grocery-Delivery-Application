# Copy to `.env` or `.env.local` and adjust.

EXPO_PUBLIC_ENV=development
EXPO_PUBLIC_TENANT_ID=puma

# Optional — force API base when LAN inference fails:
# EXPO_PUBLIC_API_DEV_URL=http://192.168.1.10:5000

# Optional hub overrides if tenant has no lat/lng in DB (see mobile-app/api/mapDeliveryHelpers.ts):
# EXPO_PUBLIC_STORE_LAT=
# EXPO_PUBLIC_STORE_LNG=
# EXPO_PUBLIC_MAP_SERVICE_URL=
# EXPO_PUBLIC_DELIVERY_POINTS_JSON=
